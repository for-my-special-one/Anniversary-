        // -------------------------------------------------------------
        // 8. SCRATCH CARD CANVAS CODE
        // -------------------------------------------------------------
        const scratchCanvas = document.getElementById('scratchCanvas');
        const sCtx = scratchCanvas.getContext('2d');
        let isScratching = false;

        function initScratch() {
            const rect = scratchCanvas.parentElement.getBoundingClientRect();
            scratchCanvas.width = rect.width;
            scratchCanvas.height = rect.height;

            const grad = sCtx.createLinearGradient(0, 0, scratchCanvas.width, scratchCanvas.height);
            grad.addColorStop(0, '#be123c');
            grad.addColorStop(0.5, '#e11d48');
            grad.addColorStop(1, '#9f1239');
            
            sCtx.fillStyle = grad;
            sCtx.fillRect(0, 0, scratchCanvas.width, scratchCanvas.height);

            sCtx.fillStyle = '#ffffff';
            sCtx.font = '18px Plus Jakarta Sans';
            sCtx.textAlign = 'center';
            sCtx.fillText('Scratch here to reveal note', scratchCanvas.width / 2, scratchCanvas.height / 2);
        }

        function scratch(e) {
            if (!isScratching) return;
            const rect = scratchCanvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            
            const x = clientX - rect.left;
            const y = clientY - rect.top;

            sCtx.globalCompositeOperation = 'destination-out';
            sCtx.beginPath();
            sCtx.arc(x, y, 25, 0, Math.PI * 2);
            sCtx.fill();
        }

        scratchCanvas.addEventListener('mousedown', (e) => { isScratching = true; scratch(e); });
        scratchCanvas.addEventListener('mousemove', scratch);
        scratchCanvas.addEventListener('mouseup', () => { isScratching = false; });

        scratchCanvas.addEventListener('touchstart', (e) => { isScratching = true; scratch(e); });
        scratchCanvas.addEventListener('touchmove', scratch);
        scratchCanvas.addEventListener('touchend', () => { isScratching = false; });

        window.addEventListener('load', initScratch);
        window.addEventListener('resize', initScratch);
    </script>
