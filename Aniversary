    <script>
        // -------------------------------------------------------------
        // 1. FLOATING HEART PARTICLES CANVAS
        // -------------------------------------------------------------
        const canvas = document.getElementById('particleCanvas');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class HeartParticle {
            constructor() {
                this.reset();
            }
            reset() {
                this.x = Math.random() * canvas.width;
                this.y = canvas.height + Math.random() * 20;
                this.size = Math.random() * 12 + 8;
                this.speedY = Math.random() * 1.5 + 0.5;
                this.opacity = Math.random() * 0.5 + 0.3;
                this.swing = Math.random() * 0.05;
                this.swingAngle = Math.random() * Math.PI * 2;
            }
            update() {
                this.y -= this.speedY;
                this.swingAngle += this.swing;
                this.x += Math.sin(this.swingAngle) * 0.5;
                if (this.y < -20) this.reset();
            }
            draw() {
                ctx.save();
                ctx.globalAlpha = this.opacity;
                ctx.fillStyle = '#f43f5e';
                ctx.font = `${this.size}px Arial`;
                ctx.fillText('❤️', this.x, this.y);
                ctx.restore();
            }
        }

        for (let i = 0; i < 25; i++) {
            particles.push(new HeartParticle());
        }

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            requestAnimationFrame(animateParticles);
        }
        animateParticles();

        // -------------------------------------------------------------
        // 2. HEART SHOWER BUTTON TRIGGER
        // -------------------------------------------------------------
        function triggerHearts() {
            confetti({
                particleCount: 40,
                spread: 60,
                origin: { y: 0.8 },
                colors: ['#f43f5e', '#fda4af', '#be123c', '#ffffff'],
                shapes: ['square']
            });
            for (let i = 0; i < 15; i++) {
                particles.push(new HeartParticle());
            }
        }

        // -------------------------------------------------------------
        // 3. BACKGROUND MUSIC SYNTH (WEB AUDIO API)
        // -------------------------------------------------------------
        let audioCtx = null;
        let isPlaying = false;
        let musicInterval = null;

        function toggleMusic() {
            const musicIcon = document.getElementById('musicIcon');
            if (!isPlaying) {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                isPlaying = true;
                musicIcon.classList.add('text-rose-500', 'animate-spin');
                playLoFiNotes();
            } else {
                isPlaying = false;
                musicIcon.classList.remove('text-rose-500', 'animate-spin');
                if (musicInterval) clearInterval(musicInterval);
            }
        }

        function playLoFiNotes() {
            const notes = [261.63, 293.66, 329.63, 349.23, 392.00, 440.00];
            musicInterval = setInterval(() => {
                if (!isPlaying || !audioCtx) return;
                
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                
                const freq = notes[Math.floor(Math.random() * notes.length)];
                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                
                gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 2);
                
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                
                osc.start();
                osc.stop(audioCtx.currentTime + 2);
            }, 1200);
        }

        // -------------------------------------------------------------
